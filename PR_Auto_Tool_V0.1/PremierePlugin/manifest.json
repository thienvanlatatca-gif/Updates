{
  "manifestVersion": 5,
  "id": "com.quan.prauto.bridge",
  "name": "PR Auto Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": { "schemes": ["https"] }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "prAutoPanel",
    "label": { "default": "PR Auto Bridge" },
    "minimumSize": { "width": 420, "height": 560 },
    "preferredDockedSize": { "width": 540, "height": 760 },
    "preferredFloatingSize": { "width": 620, "height": 820 }
  }]
}